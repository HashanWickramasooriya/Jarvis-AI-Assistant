# =========================================================
# JARVIS environment configuration
# Copy this file to .env (root, used by the server) and fill in real
# values. Never commit the real .env file. This file must only ever
# contain placeholders — never real keys.
# =========================================================

# --- Server ---
PORT=8787
# Origin the frontend dev server runs on (for CORS)
CORS_ORIGIN=http://localhost:5173

# --- AI Brain: OpenRouter (server-side only, never exposed to the browser) ---
OPENROUTER_API_KEY=
# Any Gemini Flash model available on OpenRouter, e.g. google/gemini-3.7-flash
OPENROUTER_MODEL=google/gemini-3.7-flash

# --- Speech-to-Text: Groq Whisper (server-side only) ---
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3-turbo

# --- Text-to-Speech: Groq TTS (server-side only) ---
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
GROQ_TTS_VOICE=troy

# --- Memory: Supabase Postgres ---
# Server uses the service-role/secret key (bypasses RLS) for all reads/writes.
# NEVER expose the service-role/secret key to the browser/frontend.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Frontend (Vite exposes anything prefixed VITE_ to the browser) ---
# Only the publishable/anon key belongs here — it is safe to expose
# given the read-only RLS policies in supabase/schema.sql.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Leave blank in production (Vercel and Netlify both serve the frontend
# and API from the same domain, so relative /api/* calls resolve
# automatically). Only set this for local dev against the standalone
# Express server.
VITE_API_BASE_URL=http://localhost:8787

# --- Optional: pluggable web search provider (see server/src/services/searchService.ts) ---
SEARCH_PROVIDER_URL=
SEARCH_PROVIDER_API_KEY=
